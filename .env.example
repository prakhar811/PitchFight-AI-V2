# PitchFight AI V2 — copy this file to .env and fill in values locally.
# Never commit real secrets.

APP_NAME=PitchFight AI
APP_ENV=development
API_V1_PREFIX=/api/v1

# PostgreSQL
POSTGRES_DB=pitchfight
POSTGRES_USER=pitchfight
POSTGRES_PASSWORD=pitchfight_local_dev

DATABASE_URL=postgresql+asyncpg://pitchfight:pitchfight_local_dev@localhost:5432/pitchfight

# MongoDB
MONGO_INITDB_ROOT_USERNAME=pitchfight
MONGO_INITDB_ROOT_PASSWORD=pitchfight_local_dev
MONGO_DB=pitchfight

MONGO_URL=mongodb://pitchfight:pitchfight_local_dev@localhost:27017/pitchfight?authSource=admin

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL_SECONDS=86400
REDIS_JUDGE_CONFIG_TTL_SECONDS=10800
REDIS_VOICE_TTL_SECONDS=1200

# NVIDIA (V1 local testing — never commit a real key)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_OMNI_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# JWT authentication — never commit a real secret
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
