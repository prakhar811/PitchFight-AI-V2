# PitchFight AI V2 — copy this file to .env and fill in values locally.
# Never commit real secrets.

APP_NAME=PitchFight AI
APP_ENV=development
API_V1_PREFIX=/api/v1

# PostgreSQL
POSTGRES_DB=pitchfight
POSTGRES_USER=pitchfight
POSTGRES_PASSWORD=pitchfight_local_dev

DATABASE_URL=postgresql+asyncpg://pitchfight:pitchfight_local_dev@localhost:5432/pitchfight

# MongoDB
MONGO_INITDB_ROOT_USERNAME=pitchfight
MONGO_INITDB_ROOT_PASSWORD=pitchfight_local_dev
MONGO_DB=pitchfight

MONGO_URL=mongodb://pitchfight:pitchfight_local_dev@localhost:27017/pitchfight?authSource=admin

# Redis
REDIS_URL=redis://localhost:6379/0
